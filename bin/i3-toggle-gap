#!/bin/sh

# Ugly but works!
if [ $# -eq 1 ] && [ -n "$(sed -nE 's/^gaps outer/&/p' $1)" ]; then
    # if no comment, add comment. i.e. OFF
    sed -i -E 's/^(gaps outer.*)/# \1/g' $1
    sed -i -E 's/^(gaps inner.*)/# \1/g' $1
    exit 0
fi

# if comment, remove comment. i.e. ON
sed -i -E 's/^(#\s*)(gaps outer)/\2/g' $1
sed -i -E 's/^(#\s*)(gaps inner)/\2/g' $1

if [ -n "$2" ]; then
    gap=$(sed -nE 's/gaps outer ([0-9]+)/\1/p' $1)
    gap=$((gap + $2))
    [ $gap -lt 0 ] && gap=0
    sed -i -E "s/(gaps outer ).*/\1$gap/g" $1
fi
