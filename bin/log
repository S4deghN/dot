#!/usr/bin/bash

date=$(date +%y-%m-%d)
title="$date"
log_path="$HOME/note/log/"

file=$(find $log_path -type f -name "$date*.adoc" -print -quit)
[ -n "$file" ] && exec $EDITOR $file

read -e -p "extra words for the title: " -r extra_words
[ -n "$extra_words" ] && title+=" - ${extra_words}"

file="$log_path/${title// /-}.adoc"

cat > "$file" << EOF
= $title
EOF

exec $EDITOR "$file"
