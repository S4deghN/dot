vim9script

set nocompatible
set ttimeout ttimeoutlen=0
set history=10000 termwinscroll=1000000
set hidden noswapfile undofile undodir=/tmp/$USER.vim9undo | silent system("mkdir -p /tmp/$USER.vim9undo")
set mouse=ar ttymouse=sgr
set scrolloff=3
set completeopt=menu,longest
set nowildmenu wildignorecase wildmode=longest,list,full wildcharm=<Tab>
set notitle showcmd showcmdloc=statusline laststatus=2 shortmess=aoOFtT
set nostartofline splitbelow splitright
set hlsearch incsearch ignorecase smartcase tagcase=match # if match case is not set to `match` tag search becomes really slow!
set smartindent nosmarttab expandtab shiftwidth=4 tabstop=4
set fillchars+=diff:╱,fold:\ ,vert:│
set list listchars=tab:›\ ,nbsp:␣,trail:·,extends:…,precedes:… showbreak=󱞵\
set cpoptions+=n foldmethod=marker
set cinoptions+=:s,=s,l1,b1,g0,N-s,E-s,(s,k0,j1,J1,t0,Ls
set path=.,**,/usr/include,/usr/include/x86_64-linux-gnu
set grepprg=grep\ -rnI
set keywordprg=:Man
set termguicolors
set complete-=i # can be very slow
set regexpengine=1
set updatetime=2000
set display=lastline
set maxsearchcount=9999
set diffopt+=followwrap,foldcolumn:0,algorithm:histogram
set diffopt-=closeoff
set switchbuf=useopen,uselast
set chistory=15

g:mapleader = " "

g:loaded_netrw = 1 | g:loaded_matchparen = 1 | g:loaded_vimballPlugin = 1
silent! packadd! matchit
silent! packadd! comment

plug#begin("~/.local/share/vim/plugged")
    Plug 'tpope/vim-fugitive'
    Plug 'tpope/vim-sleuth' # Heuristically set buffer options

    Plug 'romainl/vim-redir'
    Plug 'romainl/vim-qf'
        g:qf_auto_resize = 1
        g:qf_auto_open_quickfix = 0

    Plug 'junegunn/vim-easy-align'
    Plug 'junegunn/gv.vim'
    Plug 'junegunn/fzf.vim', { 'commit': 'd6aa214', 'froze': 1 }
        silent source /usr/share/doc/fzf/examples/fzf.vim

    Plug 'airblade/vim-rooter'
        g:rooter_cd_cmd = 'lcd'
        g:rooter_silent_chdir = 1
        g:rooter_patterns = [ '.git', '.svn', 'tags']
        g:rooter_targets = ['*'] # avoid setting root for directories

    Plug 'jlanzarotta/bufexplorer'
        g:bufExplorerDisableDefaultKeyMapping = 1
    Plug 'preservim/tagbar'
        g:tagbar_position = 'vertical leftabove'

    Plug 'mg979/vim-visual-multi'

    Plug 'glts/vim-magnum'
    Plug 'glts/vim-radical' # [C]hange [R]adix with 'cr' operator, 'gA' to view all representations

    Plug 'alx741/vinfo'

    # Plug 'yegappan/grep'

    Plug 'kana/vim-textobj-user'
    Plug 'kana/vim-textobj-function'

    Plug 's4deghn/PropColor'
        g:prop_colors_style = 'icon'
    Plug 's4deghn/lsp'
        runtime lsp.vim
    Plug '~/.vim/local/vim-fm'
plug#end()

if system("hostname") =~? "x580"
    colorscheme arc
else
    colorscheme arc
    hi Normal guibg=#1d1d1d guifg=#ccdada
    hi Normal guibg=#242424 guifg=#ccdada
endif

for key in 'befhijkltw'
    exe $"set <M-{key}>=\e{key}"
endfor

nnoremap <expr> y utils#SetOpFunc(function('utils#JumpToEndOfOp', ['y']))
vnoremap y <scriptcmd>utils#JumpToEndOfOp('y', 'v')<cr>
nmap yy y_
