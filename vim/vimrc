inoremap <expr> <C-e>      pumvisible() ? "\<C-e>" : "\<esc>A"
inoremap        <C-o>      <Esc>:a<cr><enter><C-c>gi
inoremap        <C-x>t     <C-r>=strftime("%H:%M")<Cr>
inoremap <expr> <c-x><c-z> fzf#vim#complete#word()

try
    def SmartPaste(op: string): string
        var ret_val: string
        if col('.') != 1 &&
                col('.') == col('$') - 1 &&
                getreg(v:register) !~ '^\s\|\n' &&
                getline(".")[-1] !~ '\s'
            ret_val = "a \<esc>"
        endif
        ret_val ..= op
        ret_val ..= "g`]"
        return ret_val
    enddef
    nnoremap <expr> p SmartPaste("p")
catch
    silent! nunmap p
    echom $'{expand("%")}:{line('.')}: {v:exception}'
endtry

try
    def CmdCr(): string
        var cmdline = getcmdline()
        if cmdline =~ '\v\C/(#|nu|num|numb|numbe|number)$'
            return "\<CR>:"
        else
            return "\<CR>"
        endif
    enddef | defcomp
    cnoremap <expr> <CR> CmdCr()
catch
    silent! cunmap <CR>
    echom $'{expand("%")}:{line('.')}: {v:exception}'
endtry

try
    def CmdCtrlU(): string
        var cmdline = getcmdline()
        var match_list = matchlist(cmdline, '\v\C^(e%[dit] |Term |Grep |Git )(.+)')
        if len(match_list) == 0
            return "\<C-u>"
        else
            return "\<C-u>" .. match_list[1]
        endif
    enddef | defcomp
    cnoremap <expr> <C-u> CmdCtrlU()
catch
    silent! cunmap <C-u>
    echom $'{expand("%")}:{line('.')}: {v:exception}'
endtry

try
    def CmdCtrlW(): string
        var cursor_pos = getcmdpos()
        var line_before_cursor = getcmdline()[0 : cursor_pos - 2]
        var match_idx = match(line_before_cursor, '\v[^ /]{-1,}/\s*$') # /this/and/[that/ ]
        if match_idx != -1
            return repeat("\<BS>", len(line_before_cursor) - match_idx)
        else
            return "\<C-w>"
        endif
    enddef | defcomp
    cnoremap <expr> <C-w> CmdCtrlW()
catch
    silent! cunmap <C-w>
    echom $'{expand("%")}:{line('.')}: {v:exception}'
endtry

command! Syn utils#Syn()
command! RT RooterToggle | exec "norm :\<C-u>cd \<C-x>d\<cr>"
command! SudoWrite exec ':silent w !sudo tee' expand('%:p') | e!
command! -nargs=+ -complete=command R put = execute(<q-args>)->trim() # write vim command output into buffer

command! -range=%          Format   utils#KeepView($':{<line1>},{<line2>}!clang-format', winsaveview(), 'c')
command! -range=% -nargs=? Expand   utils#KeepView($':{<line1>},{<line2>}!expand -t ' .. (!<q-args> ? '4' : <q-args>), winsaveview(), 'c')
command! -range=% -nargs=? Unexpand utils#KeepView($':{<line1>},{<line2>}!unexpand -t ' .. (!<q-args> ? '4' : <q-args>), winsaveview(), 'c')

augroup autoCommands
    autocmd!
    autocmd VimEnter * if len(expand("<afile>")) == 0 | :e ~/.scratch | endif
    autocmd BufWritePost *.vim,vimrc source % | set ft=vim
    autocmd BufReadPost * if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit' | exe "normal! g`\"zz" | endif
    # this option is set by ftplugin for each file type.
    # I just want a consistant format option across all file types thus the autocmd.
    autocmd BufEnter * set formatoptions=tcrqljn1p # default: tcroql
    autocmd BufWinEnter */doc/*.txt call utils#MoveOpenedWindowToSaneSplit() | setl nolist

    autocmd Filetype markdown,asciidoc,text setl spell
    autocmd Filetype qf nmap <buffer> <Esc> ZQ
    autocmd Filetype man nmap <buffer> q ZQ
    autocmd CmdwinEnter * nmap <buffer> q     :q<cr>
    autocmd CmdwinEnter * nmap <buffer> <C-c> :q<cr>

    autocmd BufAdd *.lub set filetype=lua
    autocmd BufAdd .clang* set filetype=yaml
    autocmd BufAdd /tmp/bash* set filetype=sh
    autocmd BufAdd *-MIB.txt set filetype=mib

    autocmd ShellFilterPost * if v:shell_error != 0 | undo | endif
    autocmd CompleteDone * silent! pclose

    autocmd User FugitiveIndex norm! zt

    def CapsOff()
        timer_start(100, (_) => {
            silent system("caps-off")
        })
    enddef
    autocmd InsertLeave * CapsOff()

    if exists('$TMUX')
        g:tmux_title_timer = 0
        def TmuxSetTitle()
            if g:tmux_title_timer != 0 | return | endif
            g:tmux_title_timer = timer_start(100, (_) => {
                var title = expand("%:t")
                if isdirectory(expand("%")) | title ..= '/' | endif
                if strlen(title) > 0
                    system("tmux rename-window [\"" .. title .. "\"]")
                endif
                g:tmux_title_timer = 0
            })
        enddef
        autocmd VimResume,VimEnter,BufEnter * TmuxSetTitle()
        autocmd VimLeave,VimSuspend * system("tmux set-window-option automatic-rename on")
    endif
augroup end

defcomp # to catch errors early.
